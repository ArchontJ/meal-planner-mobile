{
  "expo": {
    "name": "Meal Planner",
    "slug": "mealplanner",
    "version": "1.2.0-proto.4",
    "scheme": "mealplanner",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F9F7",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.archont.mealplanner",
      "adaptiveIcon": {
        "backgroundColor": "#1D9E75",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 7
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-system-ui",
      "expo-font",
      "./plugins/withLongPathCmake",
      "./plugins/withReleaseSigning",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F7F9F7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#111412"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aparat służy do skanowania kodów kreskowych produktów.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Aparat służy do robienia zdjęć przepisów i kodów kreskowych.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
