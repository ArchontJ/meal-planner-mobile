# Same Supabase project as the desktop app (desktop .env: VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
# Copy to .env.local. Only the publishable key – never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Google Cloud → Credentials → the Web client used by the Supabase Google provider.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com

# Optional: dev server address; localhost works over USB (adb reverse).
REACT_NATIVE_PACKAGER_HOSTNAME=localhost
